# Google Drive API Configuration
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_GENERAL=your_general_folder_id_here
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_CENTRO=your_centro_folder_id_here
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_LESTE=your_leste_folder_id_here
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_NORTE=your_norte_folder_id_here
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_OESTE=your_oeste_folder_id_here
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_SUL=your_sul_folder_id_here
NEXT_PUBLIC_GOOGLE_DRIVE_SUBFOLDER_ID=your_optional_subfolder_id_here

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Optional legacy alias if you still use anon key naming
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Prisma + Supabase Database
DATABASE_URL="postgresql://postgres.misxhskydzsjgskyzsid:your_password_here@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.misxhskydzsjgskyzsid:your_password_here@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Exact admin emails allowed to access restricted admin areas
ADMIN_EMAILS="jorge@example.com,erick@example.com,murilo@example.com"

# Error monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn_here
SENTRY_DSN=your_server_sentry_dsn_here
SENTRY_ORG=your_sentry_organization_slug
SENTRY_PROJECT=your_sentry_project_slug
SENTRY_AUTH_TOKEN=your_sentry_source_map_token

# Transactional email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_FROM_EMAIL="Raizes Negras <notificacoes@raizesnegrasma.com.br>"
NEXT_PUBLIC_SITE_URL=https://raizesnegrasma.com.br
